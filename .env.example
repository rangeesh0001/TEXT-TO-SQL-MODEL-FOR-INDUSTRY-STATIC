# Copy this file to .env and fill in your values.
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Which Gemini model the agent uses
GEMINI_MODEL=gemini-flash-lite-latest

# Price per 1M tokens, used only for the cost estimates shown in the UI and
# /cost/report. Defaults are the paid-tier list price for Gemini 3.5 Flash-Lite
# (https://ai.google.dev/gemini-api/docs/pricing). On the free tier you pay $0;
# update these if you change GEMINI_MODEL.
LLM_INPUT_COST_PER_MTOK=0.30
LLM_OUTPUT_COST_PER_MTOK=2.50

# Optional — controls how many tables get passed to the LLM on large schemas
# Default is 12. Lower = cheaper, higher = more accurate on complex queries
SCHEMA_FILTER_TOP_N=12
