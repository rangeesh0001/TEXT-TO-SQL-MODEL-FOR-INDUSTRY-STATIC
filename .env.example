# Copy this file to .env and fill in your values
# Sign up at console.anthropic.com, go to API Keys, and create a new key — free tier includes $5 of credits.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional — controls how many tables get passed to the LLM on large schemas
# Default is 12. Lower = cheaper, higher = more accurate on complex queries
SCHEMA_FILTER_TOP_N=12